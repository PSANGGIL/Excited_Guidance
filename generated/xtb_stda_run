#!/bin/bash

# 1. 단일 분자 계산용 Worker 스크립트 자동 생성
cat << 'EOF' > run_single.sh
#!/bin/bash
sdf_file="$1"
base_name="${sdf_file%.*}"

# 한 계산당 사용할 CPU 코어 수 제한 (서버 상황에 맞게 조절)
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# 1) 분자별로 독립된 작업 폴더 생성 및 파일 복사
mkdir -p "$base_name"
cp "$sdf_file" "$base_name/"
cd "$base_name" || exit

# 2) 해당 폴더 안에서 순차적 계산 수행 (최적화 조건 완화 적용)
xtb "$sdf_file" --opt loose --cycles 500 > "${base_name}_opt.log" 2>&1

# 3) xyz 대신 xtbopt.sdf 파일이 성공적으로 생성되었는지 확인
if [ -f "xtbopt.sdf" ]; then
    # 덮어쓰기 방지를 위해 이름 변경
    mv xtbopt.sdf "${base_name}_opt.sdf"
    
    # 4) 들뜬상태 계산 파이프라인
    xtb4stda "${base_name}_opt.sdf" > "${base_name}_xtb4stda.log" 2>&1
    stda -xtb -e 10.0 > "${base_name}_stda.log" 2>&1
    
    # 5) 계산 완료 후 불필요한 찌꺼기 파일들 꼼꼼하게 삭제
    rm -f wfn.xtb tda.dat xtbrestart xtbtopo.* charges wbo xtbopt.log
    
    echo "[완료] $base_name"
else
    echo "[실패] $base_name (최적화 실패 - 결과 파일 없음)"
fi
EOF

# Worker 스크립트에 실행 권한 부여
chmod +x run_single.sh

# 2. xargs를 이용한 병렬 실행
# -n 1 : 한 번에 한 파일씩 run_single.sh에 넘김
# -P 8 : 동시에 실행할 병렬 작업(Job)의 개수 (서버 코어 수에 맞게 조절)
find . -maxdepth 1 -type f -name '*.sdf' -print0 \
    | sort -z \
    | xargs -0 -r -n 1 -P 8 ./run_single.sh

echo "모든 병렬 계산이 종료되었습니다."

# 3. 모든 병렬 계산이 끝난 뒤 STDA 결과를 Excel로 취합
# 각 *_stda.log의 state 1~10 중 oscillator strength(fL)가 가장 큰 행을 선택한다.
python3 - << 'PY'
from __future__ import annotations

import csv
import re
from pathlib import Path


STATE_LIMIT = 10
OUTPUT_FILE = Path("stda_top_os_state1-10.csv")
HEADER = (
    "molecule_file",
    "log_file",
    "state",
    "energy_eV",
    "wavelength_nm",
    "oscillator_strength",
    "status",
)
ROW_PATTERN = re.compile(
    r"^\s*(\d+)\s+"
    r"([-+]?\d+(?:\.\d+)?(?:[Ee][-+]?\d+)?)\s+"
    r"([-+]?\d+(?:\.\d+)?(?:[Ee][-+]?\d+)?)\s+"
    r"([-+]?\d+(?:\.\d+)?(?:[Ee][-+]?\d+)?)\b"
)


def extract_top_state(log_path: Path):
    text = log_path.read_text(encoding="utf-8", errors="replace")
    in_excitation_table = False
    candidates = []

    for line in text.splitlines():
        normalized = " ".join(line.split())
        if normalized.startswith("state eV nm fL"):
            in_excitation_table = True
            continue
        if not in_excitation_table:
            continue

        match = ROW_PATTERN.match(line)
        if match is None:
            if candidates:
                break
            continue

        state = int(match.group(1))
        if state > STATE_LIMIT:
            break
        energy_ev = float(match.group(2))
        wavelength_nm = float(match.group(3))
        oscillator_strength = float(match.group(4))
        candidates.append(
            (oscillator_strength, -state, state, energy_ev, wavelength_nm)
        )

    if not candidates:
        return None
    _, _, state, energy_ev, wavelength_nm = max(candidates)
    oscillator_strength = max(candidates)[0]
    return state, energy_ev, wavelength_nm, oscillator_strength


result_rows = []
success_count = 0
for log_path in sorted(Path(".").glob("*/*_stda.log")):
    molecule_name = f"{log_path.parent.name}.sdf"
    result = extract_top_state(log_path)
    if result is None:
        result_rows.append(
            (molecule_name, str(log_path), "", "", "", "", "no state 1-10 found")
        )
        continue
    state, energy_ev, wavelength_nm, oscillator_strength = result
    result_rows.append(
        (
            molecule_name,
            str(log_path),
            state,
            energy_ev,
            wavelength_nm,
            oscillator_strength,
            "ok",
        )
    )
    success_count += 1

with OUTPUT_FILE.open("w", newline="", encoding="utf-8-sig") as output_handle:
    writer = csv.writer(output_handle)
    writer.writerow(HEADER)
    writer.writerows(result_rows)
print(
    f"[CSV 저장 완료] {OUTPUT_FILE.resolve()} "
    f"(성공 {success_count}, 파싱 실패 {len(result_rows) - success_count})"
)
PY
